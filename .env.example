# Copy this file to .env and fill in your own values. Never commit .env.

# MBTA V3 API key (free): https://api-v3.mbta.com
MBTA_KEY=

# Claude API key for plain-English trip explanations (optional: without it the
# site shows the data-only explanation)
LLM_API_KEY=

# Snowflake, key-pair login (optional for the website; needed for the pipeline,
# policy search and trip logs). See sql/01_setup.sql.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=TRANSITWISE_DB
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/transitwise_rsa_key.p8

# OpenTripPlanner (defaults shown)
# OTP_URL=http://localhost:8080/otp/gtfs/v1
# OTP_DATA_DIR=~/transitwise-otp
